{
  "name": "pmcc-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The PMCC backtest site: a static Vite + React app over the results pmcc export writes (ARCHITECTURE §13).",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "gen:types": "node scripts/gen-types.mjs",
    "dev": "npm run gen:types && vite",
    "build": "npm run gen:types && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run gen:types && tsc -b --noEmit",
    "lint": "eslint .",
    "test": "npm run gen:types && vitest run",
    "e2e": "node -e \"console.error('Not built yet: see docs/BUILD-PLAN.md P4-08.'); process.exit(1)\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@radix-ui/react-select": "^2.3.7",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
