# Credentials: never commit, print, or copy (LSEG-DATA-GUIDE §1)
lseg-data.config.json

# Raw LSEG cache: NVDA's is committed (PO, DEC-05). Other symbols, probe reports and fetch logs
# stay local until the PO adds a symbol
data_cache/*
!data_cache/NVDA/
logs/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage

# Web (generated by `pmcc export` / the build; see ARCHITECTURE §12–13)
node_modules/
web/dist/
web/public/data/
web/src/types/generated/
web/test-results/
web/playwright-report/
*.egg-info/
build/
dist/

# Local tooling and OS files
.claude/settings.local.json
Thumbs.db
desktop.ini
.DS_Store
